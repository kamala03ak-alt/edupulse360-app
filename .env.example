# Supabase project settings. Use the publishable/anon key in browser-safe contexts only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret for future trusted backend jobs. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=server-only-key

# Optional server-only Gemini key for a later read-only assistant phase.
GEMINI_API_KEY=server-only-key
